{
  "name": "nagarik-saathi-root",
  "version": "1.0.0",
  "description": "Nagarik Saathi Monorepo Root",
  "type": "module",
  "private": true,
  "scripts": {
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend/vite --include=dev",
    "install-all": "npm install --include=dev && npm install --prefix backend && npm install --prefix frontend/vite --include=dev",
    "build:frontend": "npm run build --prefix frontend/vite",
    "start": "node backend/server.js",
    "dev": "npm run build:frontend && node backend/server.js",
    "eval": "node backend/rag_eval.js",
    "seed": "npm run seed --prefix backend"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^8.2.2",
    "puppeteer-core": "^25.9.0",
    "typescript": "^7.0.2"
  }
}