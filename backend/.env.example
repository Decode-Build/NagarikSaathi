# NagarikSaathi — Environment Configuration Template
# Copy this file to .env and fill in your credentials

# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your_secure_jwt_secret_min_32_characters_here
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# MongoDB Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/nagariksaathi
MONGODB_URI=mongodb://127.0.0.1:27017/nagariksaathi

# Google Gemini AI API Key (RAG Chat, Multimodal Audio STT, Vision OCR)
# Get key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Tavily Live Search API Key (Real-time government scheme discovery)
# Get key from https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# n8n Automation Workflow Webhooks (Optional for production WhatsApp / PDF automation)
N8N_WHATSAPP_SHARE_WEBHOOK=https://your-n8n-instance.cloud/webhook/scheme-alert
N8N_FORM_AUTOFILL_WEBHOOK=https://your-n8n-instance.cloud/webhook/submit-beneficiary-form
N8N_OTP_SEND_WEBHOOK=https://your-n8n-instance.cloud/webhook/otp-send
N8N_OTP_VERIFY_WEBHOOK=https://your-n8n-instance.cloud/webhook/otp-verify
